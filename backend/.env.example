# Application
APP_NAME=Lokia AI
APP_VERSION=0.2.0
DEBUG=false

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://lokia:lokia@db:5432/lokia

# Redis
REDIS_URL=redis://redis:6379/0

# ==== AI Configuration ====

# Default model: "qwen-local" for local Qwen, or "gpt-4" / "claude-3-opus" for cloud
DEFAULT_AI_MODEL=qwen-local

# Local Model (Ollama on GPU server)
LOCAL_MODEL_URL=http://51.15.140.134:11434
LOCAL_MODEL_NAME=qwen3:30b

# Cloud AI Providers (optional, for fallback)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Inference Parameters (tuned for quality)
AI_TEMPERATURE=0.7
AI_TOP_P=0.9
AI_TOP_K=20
AI_MAX_TOKENS=4096
AI_REPETITION_PENALTY=1.05

# System Prompt
AI_SYSTEM_PROMPT=Tu es Lokia, une assistante IA intelligente, utile et bienveillante. Tu reponds de maniere precise, structuree et naturelle. Tu t'adaptes a la langue de l'utilisateur.

# CORS
CORS_ORIGINS=["http://localhost:3000"]
